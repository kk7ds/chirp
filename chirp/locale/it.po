"     (\"CLONE\" apparirà sul display)\n"
"5. Premi [MONI] per ricevere.\n"
"     (\"SAVING\" apparirà sul display)\n"

#: ../drivers/yaesu_clone.py:247
msgid ""
"1. Turn radio off.\n"
"2. Connect data cable.\n"
"3. Prepare radio for clone.\n"
"4. <b>After clicking OK</b>, press the key to send image.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Prepara la radio per il clone.\n"
"4. <b>Dopo aver fatto clic su OK</b>, premi il tasto per inviare l'immagine.\n"

