#: ../drivers/alinco.py:609 ../drivers/alinco.py:618
msgid ""
"1. Ensure your firmware version is 4_10 or higher\n"
"2. Turn radio off\n"
"3. Connect your interface cable\n"
"4. Turn radio on\n"
"5. Press and release PTT 3 times while holding MONI key\n"
"6. Supported baud rates: 57600 (default) and 19200\n"
"   (rotate dial while holding MONI to change)\n"
"7. Click OK\n"
msgstr ""
"1. Assicurati che la versione del firmware sia 4_10 o superiore\n"
"2. Spegni la radio\n"
"3. Collega il cavo dell'interfaccia\n"
"4. Accendi la radio\n"
"5. Premi e rilascia il PTT 3 volte mentre tieni premuto il tasto MONI\n"
"6. Velocità di trasmissione supportate: 57600 (predefinito) e 19200\n"
"   (per cambiare, ruota il selettore, tenendo premuto MONI)\n"
"7. Fai clic su OK\n"

#: ../drivers/ft2900.py:1253
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"A/N LOW\" button, turn radio on.\n"
"4. <b>After clicking OK</b>, press \"SET MHz\" to send image.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tenendo premuto il pulsante \"A/N LOW\", accendi la radio.\n"
"4. <b>Dopo aver fatto clic su OK</b>, premi \"SET MHz\" per inviare l'immagine.\n"

#: ../drivers/ft2900.py:1258
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"A/N LOW\" button, turn radio on.\n"
"4. Press \"MW D/MR\" to receive image.\n"
"5. Make sure display says \"-WAIT-\" (see note below if not)\n"
"6. Click OK to dismiss this dialog and start transfer.\n"
"Note: if you don't see \"-WAIT-\" at step 5, try cycling\n"
"      power and pressing and holding red \"*L\" button to unlock\n"
"      radio, then start back at step 1.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tenendo premuto il pulsante \"A/N LOW\", accendi la radio.\n"
"4. Premi \"MW D/MR\" per acquisire l'immagine.\n"
"5. Assicurati che il display indichi \"-WAIT-\" (in caso contrario, vedi la nota seguente)\n"
"6. Fai clic su OK per chiudere la finestra di dialogo ed avviare il trasferimento.\n"
"Nota: se al punto 5 non viene visualizzato il messaggio \"-WAIT-\",\n"
"      prova a spegnere la radio, tenendo premuto il pulsante\n"
"      rosso \"*L\" per sbloccarla, quindi ricomincia dal punto 1.\n"

#: ../drivers/ft8100.py:94
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"F/W\" button, turn radio on.\n"
"4. <b>After clicking OK</b>, press \"RPT\" to send image.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tenendo premuto il pulsante \"F/W\", accendi la radio.\n"
"4. <b>Dopo aver fatto clic su OK</b>, premi \"RPT\" per inviare l'immagine.\n"

#: ../drivers/ft8100.py:99
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"F/W\" button, turn radio on.\n"
"4. Press \"REV\" to receive image.\n"
"5. Click OK to start transfer.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tenendo premuto il pulsante \"F/W\", accendi la radio.\n"
"4. Premi \"REV\" per acquisire l'immagine.\n"
"5. Fai clic su OK per avviare il trasferimento.\n"

#: ../drivers/ft7100.py:1130
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"TONE\" and \"REV\" buttons, turn radio on.\n"
"4. <b>After clicking OK</b>, press \"TONE\" to send image.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tenendo premuto i pulsanti \"TONE\" e \"REV\", accendi la radio.\n"
"4. <b>Dopo aver fatto clic su OK</b>, premi \"TONE\" per inviare l'immagine.\n"

#: ../drivers/ft7100.py:1135
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"TONE\" and \"REV\" buttons, turn radio on.\n"
"4. Press \"REV\" to receive image.\n"
"5. Make sure display says \"CLONE RX\" and green led is blinking\n"
"6. Click OK to start transfer.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tenendo premuto i pulsanti \"TONE\" e \"REV\", accendi la radio.\n"
"4. Premi \"REV\" per acquisire l'immagine.\n"
"5. Assicurati che il display indichi \"CLONE RX\" e che il led verde lampeggi.\n"
"6. Fai clic su OK per avviare il trasferimento.\n"

#: ../drivers/ft2800.py:206
msgid ""
"1. Turn radio off.\n"
"2. Connect cable\n"
"3. Press and hold in the MHz, Low, and D/MR keys on the radio while turning it on\n"
"4. Radio is in clone mode when TX/RX is flashing\n"
"5. <b>After clicking OK</b>, press the MHz key on the radio to send image.\n"
"    (\"TX\" will appear on the LCD). \n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tieni premuti i tasti MHz, Low e D/MR sulla radio mentre la accendi.\n"
"4. La radio è in modalità clone quando TX/RX lampeggia.\n"
"5. <b>Dopo aver fatto clic su OK</b>, premi il tasto MHz sulla radio per inviare l'immagine.\n"
"    (sul display apparirà la scritta \"TX\"). \n"

#: ../drivers/ft2800.py:216
msgid ""
"1. Turn radio off.\n"
"2. Connect cable\n"
"3. Press and hold in the MHz, Low, and D/MR keys on the radio while turning it on\n"
"4. Radio is in clone mode when TX/RX is flashing\n"
"5. Press the Low key on the radio (\"RX\" will appear on the LCD).\n"
"6. Click OK."
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati.\n"
"3. Tieni premuti i tasti MHz, Low e D/MR sulla radio mentre la accendi.\n"
"4. La radio è in modalità clone quando TX/RX lampeggia.\n"
"5. Premi il tasto Low sulla radio (sul display apparirà la scritta \"RX\").\n"
"6. Fai clic su OK."

#: ../drivers/ft450d.py:436
msgid ""
"1. Turn radio off.\n"
"2. Connect cable to ACC jack.\n"
"3. Press and hold in the [MODE &lt;] and [MODE &gt;] keys while\n"
"     turning the radio on (\"CLONE MODE\" will appear on the\n"
"     display).\n"
"4. <b>After clicking OK</b> here, press the [C.S.] key to\n"
"    send image.\n"
msgstr ""
"1. Spegni la radio.\n"
"2. Collega il cavo dati alla presa ACC.\n"
"3. Tieni premuti i tasti [MODE &lt;] e [MODE &gt;] mentre\n"
"     accendi la radio (sul display apparirà la scritta\n"
"     \"CLONE MODE\").\n"
"4. <b>Dopo aver fatto clic su OK</b>, premi il tasto [C.S.] per\n"
"    inviare l'immagine.\n"

