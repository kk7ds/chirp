#: ../drivers/alinco.py:609 ../drivers/alinco.py:618
msgid ""
"1. Ensure your firmware version is 4_10 or higher\n"
"2. Turn radio off\n"
"3. Connect your interface cable\n"
"4. Turn radio on\n"
"5. Press and release PTT 3 times while holding MONI key\n"
"6. Supported baud rates: 57600 (default) and 19200\n"
"   (rotate dial while holding MONI to change)\n"
"7. Click OK\n"
msgstr ""
"1. Asigură-te că versiunea ta de firmware este 4_10 sau mai mare\n"
"2. Oprește stația\n"
"3. Conectează cablul de interfață\n"
"4. Pornește stația\n"
"5. Apasă și eliberează PTT de 3 ori ținând apăsat butonul MONI\n"
"6. Vitezele de baud suportate: 57600 (implicit) și 19200\n"
"   (roteste butonul pentru a schimba, ținând apăsat MONI)\n"
"7. Apasă OK\n"

#: ../drivers/ft2900.py:1253
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"A/N LOW\" button, turn radio on.\n"
"4. <b>After clicking OK</b>, press \"SET MHz\" to send image.\n"
msgstr ""
"1. Oprește stația.\n"
"2. Conectează cablul de date.\n"
"3. În timp ce ții apăsat butonul \"A/N LOW\", pornește stația.\n"
"4. <b>După ce apesi OK</b>, apasă \"SET MHz\" pentru a trimite imaginea.\n"

#: ../drivers/ft2900.py:1258
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"A/N LOW\" button, turn radio on.\n"
"4. Press \"MW D/MR\" to receive image.\n"
"5. Make sure display says \"-WAIT-\" (see note below if not)\n"
"6. Click OK to dismiss this dialog and start transfer.\n"
"Note: if you don't see \"-WAIT-\" at step 5, try cycling\n"
"      power and pressing and holding red \"*L\" button to unlock\n"
"      radio, then start back at step 1.\n"
msgstr ""
"1. Oprește stația.\n"
"2. Conectează cablul de date.\n"
"3. În timp ce ții apăsat butonul \"A/N LOW\", pornește stația.\n"
"4. Apasă \"MW D/MR\" pentru a primi imaginea.\n"
"5. Asigură-te că pe display apare \"-WAIT-\" (vezi nota de mai jos dacă nu apare)\n"
"6. Apasă OK pentru a închide acest dialog și a începe transferul.\n"
"Notă: dacă nu vezi \"-WAIT-\" la pasul 5, încearcă să repornești\n"
"      stația și să ții apăsat butonul roșu \"*L\" pentru a debloca\n"
"      stația, apoi începe din nou cu pasul 1.\n"

#: ../drivers/ft8100.py:94
msgid ""
"1. Turn Radio off.\n"
"2. Connect data cable.\n"
"3. While holding \"F/W\" button, turn radio on.\n"
"4. <b>After clicking OK</b>, press \"RPT\" to send image.\n"
