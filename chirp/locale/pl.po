"2. Connect data cable.\n"
"3. While holding \"F/W\" button, turn radio on.\n"
"4. <b>After clicking OK</b>, press \"RPT\" to send image.\n"
msgstr ""

#: ../drivers/ft8100.py:99
msgid ""
