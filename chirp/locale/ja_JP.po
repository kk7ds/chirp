#: ../drivers/radtel_rt880g.py:1230
msgid "Sets whether scanning steps upwards or downwards."
msgstr ""

#: ../drivers/radtel_rt880g.py:2523
msgid "Sets whether the fixed latitude is north (N) or south (S) of the equator."
msgstr ""

#: ../drivers/radtel_rt880g.py:2542
msgid "Sets whether the fixed longitude is east (E) or west (W) of the prime meridian."
msgstr ""

