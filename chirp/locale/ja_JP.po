#: ../drivers/radtel_rt880g.py:1483 ../drivers/radtel_rt880g.py:1510
#: ../drivers/radtel_rt880g.py:1537 ../drivers/radtel_rt880g.py:1564
#, python-format
msgid "Sets what the radio allows between the start and end frequencies of lock range %d: Unlock leaves the range unrestricted, Rx Only allows receiving only, and Lock locks the range."
msgstr ""

#: ../drivers/ft450d.py:1320
msgid "Sets when the scan resumes after it has paused on a signal. 1 to 10 resumes after that many seconds, 0 selects BUSY, which waits until the signal has gone. In SSB, CW and SSB based data modes the scanner instead steps slowly across a signal, giving you time to stop it."
