#: ../drivers/radtel_rt880g.py:2051 ../drivers/radtel_rt880g.py:2066
#: ../drivers/radtel_rt880g.py:2081 ../drivers/radtel_rt880g.py:2096
#: ../drivers/radtel_rt880g.py:2111 ../drivers/radtel_rt880g.py:2126
#: ../drivers/radtel_rt880g.py:2141 ../drivers/radtel_rt880g.py:2156
#: ../drivers/radtel_rt880g.py:2171 ../drivers/radtel_rt880g.py:2186
#: ../drivers/radtel_rt880g.py:2201 ../drivers/radtel_rt880g.py:2216
#: ../drivers/radtel_rt880g.py:2231
#, python-format
msgid "Sets the temporary transmit power value for the %s range, from 0 to 254, used while Power Test is on. Above a limit that differs from radio to radio, higher values only raise the current without raising the power, and can damage the power amplifier."
msgstr ""

#: ../drivers/radtel_rt880g.py:2314
msgid "Sets the threshold for decoding received DTMF tones, from 0 to 63."
msgstr ""

#: ../drivers/radtel_rt880g.py:2437
msgid "Sets the time zone of your location, as an offset from UTC."
msgstr ""

#: ../drivers/ft450d.py:1294
msgid "Sets the time-out timer for computer control commands arriving on the CAT jack. Command input that continues for longer than this time is cut off. The radio shows the shortest setting as 10 ms."
msgstr ""

#: ../drivers/ft450d.py:1386
msgid "Sets the transmit power in watts. Use the lowest power that provides reliable communication, and a half to a third of full power for data transmissions longer than a few minutes."
msgstr ""

#: ../drivers/radtel_rt880g.py:1165
msgid "Sets the transmit priority, which decides the main area after a call. With Busy, the main area automatically switches to the area of the last active call when the conversation ends. With Edit, the main area stays where you set it."
