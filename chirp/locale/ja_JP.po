#: ../drivers/radtel_rt880g.py:1904
msgid "Sets the microphone sensitivity, from 0 to 31. Higher values make the microphone more sensitive."
msgstr ""

#: ../drivers/radtel_rt880g.py:2856 ../drivers/radtel_rt880g.py:2876
#, python-format
msgid "Sets the name of digipeater %d, which the path in received APRS data must match for the radio to forward it."
msgstr ""

