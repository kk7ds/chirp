#: ../drivers/radtel_rt880g.py:2303
msgid "Sets the level of the transmitted DTMF tones, from 0 to 127."
msgstr ""

#: ../drivers/radtel_rt880g.py:1493 ../drivers/radtel_rt880g.py:1520
#: ../drivers/radtel_rt880g.py:1547 ../drivers/radtel_rt880g.py:1574
#, python-format
msgid "Sets the lowest frequency of lock range %d, in MHz."
msgstr ""

#: ../drivers/radtel_rt880g.py:1595
msgid "Sets the message shown on the display when the radio starts, up to 32 characters."
msgstr ""

#: ../drivers/ft450d.py:1831
