#: ../drivers/radtel_rt880g.py:2777
msgid "Sets the interval for queue beaconing, from 0 to 59."
msgstr ""

#: ../drivers/radtel_rt880g.py:2792
msgid "Sets the level of the transmitted APRS signal."
