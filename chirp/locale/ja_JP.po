#: ../drivers/radtel_rt880g.py:2551
msgid "Sets the fixed altitude that goes with the fixed latitude and longitude."
msgstr ""

#: ../drivers/radtel_rt880g.py:2513
msgid "Sets the fixed latitude, which APRS uses as this radio's position when Station Mode is Fixed."
msgstr ""

#: ../drivers/radtel_rt880g.py:2532
msgid "Sets the fixed longitude, which APRS uses as this radio's position when Station Mode is Fixed."
msgstr ""

#: ../drivers/ft450d.py:1785
msgid "Sets the frequency shift between the mark and space tones in FSK RTTY. Most amateur RTTY uses 170 Hz."
